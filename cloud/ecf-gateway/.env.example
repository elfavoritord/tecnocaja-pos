# =============================================================
# Tecno Caja e-CF Gateway — plantilla de configuración
# Copia a .env para correr local. En Cloud Run, estas se pasan
# con --set-env-vars (ver README.md).
# =============================================================

# Puerto HTTP. Cloud Run lo inyecta automáticamente — no lo fijes ahí.
PORT=8080

# TEST | CERT | PROD — solo informativo, aparece en /health.
DGII_ENVIRONMENT=CERT

# RNC/cédula de la empresa por defecto (la de Emilio). Activa el modo
# multiempresa: esta empresa no necesita registrarse y firma con CERT_PATH;
# las demás se registran con POST /admin/tenants y solo se aceptan esas
# (un e-CF para otro RNC se responde con ARECF Estado 1, motivo 4).
# Vacío = modo de una sola empresa (acepta cualquier RNC y firma todo con CERT_PATH).
GATEWAY_DEFAULT_RNC=40211932609

# businessId que se guarda en los documentos de la empresa por defecto.
GATEWAY_BUSINESS_ID=tecnocaja-emilio

# Token de administrador (Emilio): registra empresas y ve las de todas.
# Cada cliente usa su propio token de empresa, que solo ve lo suyo.
# Genera con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
GATEWAY_ADMIN_TOKEN=

# Certificado de la empresa por defecto (secret file en Cloud Run).
CERT_PATH=
CERT_PASSWORD=

# Llave de Cloud KMS con que se cifran los .p12 de cada empresa. Vacío usa
# la misma de la app Android: tecno-caja-fiscal/certificate-vault.
ECF_KMS_KEY_NAME=

# Proyecto de Firestore. Reutiliza el proyecto Firebase ya activo del POS
# (ver .firebaserc en la raíz del repo) — no crear un proyecto GCP nuevo.
FIRESTORE_PROJECT_ID=reporte-sistema-pos
