# =============================================================
# Tecno Caja e-CF Gateway — plantilla de configuración
# Copia a .env para correr local. En Cloud Run, estas se pasan
# con --set-env-vars (ver README.md).
# =============================================================

# Puerto HTTP. Cloud Run lo inyecta automáticamente — no lo fijes ahí.
PORT=8080

# TEST | CERT | PROD — solo informativo, aparece en /health.
DGII_ENVIRONMENT=CERT

# Identificador del negocio dueño de este gateway (single-tenant por ahora).
GATEWAY_BUSINESS_ID=tecnocaja-emilio

# Token bearer que el POS usa para leer GET /admin/received.
# Genera con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
GATEWAY_ADMIN_TOKEN=

# Proyecto de Firestore. Reutiliza el proyecto Firebase ya activo del POS
# (ver .firebaserc en la raíz del repo) — no crear un proyecto GCP nuevo.
FIRESTORE_PROJECT_ID=reporte-sistema-pos
