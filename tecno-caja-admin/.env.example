# Tecno Caja Admin — Variables de entorno
# Copia este archivo como .env y completa los valores

ADMIN_PORT=3400

# ── Firebase Admin SDK (backend) ───────────────────────────────────────────
# Opción A: ruta al archivo JSON (recomendado para desarrollo local)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Opción B: JSON completo como string (útil para CI/CD sin archivos)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Firebase proyecto ──────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=tu-proyecto-firebase

# ── Firebase Web SDK (cliente) ─────────────────────────────────────────────
# Estos valores se sirven al cliente vía /api/firebase-config (nunca exponer service account)
# Copia desde: Firebase Console → Configuración → Tus apps → Web app → SDK setup
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
# También se usa en el backend (Admin SDK) para subir adjuntos de Compras/Gastos a Storage
FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abc123

# ── Colecciones Firestore (deben coincidir con el POS) ─────────────────────
# FIREBASE_ADMIN_LICENSES_COLLECTION=licencias
# FIREBASE_ADMIN_USERS_COLLECTION=usuarios

# ── Facturación de servicios (datos del emisor — tu empresa) ───────────────
# Se usan como encabezado en las facturas que le emites a tus clientes de
# Tecno Caja POS. El logo NO va aquí — se sube desde Configuración dentro
# del panel (se guarda en Firestore, no en un archivo).
ADMIN_COMPANY_NAME=Tecno Caja
# ADMIN_COMPANY_RNC=
# ADMIN_COMPANY_ADDRESS=
# ADMIN_COMPANY_PHONE=
# ADMIN_COMPANY_EMAIL=
# ADMIN_INVOICE_PREFIX=FAC
