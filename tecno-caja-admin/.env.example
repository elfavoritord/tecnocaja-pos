# Tecno Caja Admin — Variables de entorno
# Copia este archivo como .env y completa los valores

# Puerto del servidor admin (default: 3400)
ADMIN_PORT=3400

# Secret para firmar JWT de admins (cambia esto)
ADMIN_JWT_SECRET=tecnocaja-admin-secret-cambia-esto-en-produccion

# Firebase — elige una de las dos opciones:

# Opción A: JSON del service account como string (útil para CI/CD)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Opción B: Ruta al archivo .json del service account
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Project ID de Firebase (requerido)
FIREBASE_PROJECT_ID=tu-proyecto-firebase
