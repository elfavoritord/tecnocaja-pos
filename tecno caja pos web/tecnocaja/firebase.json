{
  "hosting": {
    "site": "tecnocajapos",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "preview-*.png"
    ],
    "headers": [
      {
        "source": "**/*.@(css|js|png|jpg|jpeg|webp|svg|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=3600"
          }
        ]
      },
      {
        "source": "descargas/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=3600"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment"
          }
        ]
      }
    ]
  }
}
