# ── Tecno Caja Contadores — Variables de entorno ───────────────────────────
# Copia este archivo como .env y completa los valores.

# Puerto del servidor Express (no cambiar sin razón)
CONTADORES_PORT=3401

# ── Firebase Admin SDK ─────────────────────────────────────────────────────
# Usa el mismo service account que tecno-caja-admin (mismo proyecto Firebase)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# O pega el JSON completo como string (útil en CI/CD):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ID del proyecto Firebase (debe coincidir con el service account)
FIREBASE_PROJECT_ID=reporte-sistema-pos

# ── Firebase Web SDK (para el cliente) ────────────────────────────────────
# Obtén estos valores en Firebase Console → Configuración → Tu app web
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ── Colecciones Firestore (no cambiar si usas las mismas del POS) ─────────
FIREBASE_ADMIN_LICENSES_COLLECTION=licencias
