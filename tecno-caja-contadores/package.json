{
  "name": "tecno-caja-contadores",
  "version": "1.0.10",
  "description": "Panel de contadores asociados — Tecno Caja",
  "main": "main.js",
  "private": true,
  "author": {
    "name": "Emilio",
    "email": "emiliomanaurys@gmail.com"
  },
  "scripts": {
    "start": "chcp 65001 > nul && ..\\node_modules\\electron\\dist\\electron.exe .",
    "build": "cd .. && npx electron-builder --config tecno-caja-contadores/electron-builder.yml --win nsis",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\release.ps1 -Bump patch",
    "release:minor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\release.ps1 -Bump minor",
    "release:major": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\release.ps1 -Bump major"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dgii-rnc": "^1.0.1",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^10.3.0",
    "helmet": "^8.0.0",
    "jspdf": "^4.2.1",
    "xlsx": "^0.18.5"
  }
}
