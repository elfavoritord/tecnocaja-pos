# ── Servidor MCP de Tecno Caja (solo lectura del POS, OAuth 2.1) ─────────────
# Copia este archivo a  mcp-server/.env  y rellena los valores.

# Puerto local del servidor MCP (distinto al 3399 del POS).
MCP_PORT=3400
# Host de bind. Déjalo en 127.0.0.1: el túnel Cloudflare es quien lo expone.
MCP_BIND_HOST=127.0.0.1

# URL pública HTTPS con la que ChatGPT / Claude llegan al servidor, vía el túnel
# Cloudflare con NOMBRE FIJO (no el quick tunnel, que cambia al reiniciar).
# Es el "issuer" OAuth: https obligatorio (salvo 127.0.0.1 para pruebas locales),
# sin barra final, sin query ni #fragmento.
#   ej:  https://mcp.tudominio.com
MCP_PUBLIC_URL=https://mcp.tudominio.com

# ── Login del MCP (OAuth 2.1, usuario/clave propios) ─────────────────────────
# Único usuario que puede iniciar sesión y autorizar el conector.
MCP_AUTH_USER=emilio
MCP_AUTH_PASSWORD=

# Vida del access token en segundos (el refresh token no caduca; se rota al usarlo).
MCP_TOKEN_TTL_SEC=3600
# Archivo donde se guardan los clientes OAuth registrados y los refresh tokens.
# (por defecto  mcp-server/.oauth-store.json)
# MCP_OAUTH_STORE=

# Token de máquina OPCIONAL: si lo defines, se acepta como  Authorization: Bearer
# <token>  SIN pasar por OAuth (cómodo para Claude Code / curl / scripts).
# Déjalo vacío para exigir OAuth a todos. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_ACCESS_TOKEN=

# ── Backend del POS al que el MCP le consulta ───────────────────────────────
POS_BASE_URL=http://127.0.0.1:3399
# Usuario dedicado del POS con rol que pueda ver Reportes (administrador).
# NO reutilices el usuario del dueño.
POS_MCP_USER=mcp
POS_MCP_PASSWORD=
POS_BOOTSTRAP_TTL_MS=300000

MCP_SERVER_NAME=tecno-caja-pos
