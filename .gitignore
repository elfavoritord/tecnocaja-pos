# === Tecno Caja .gitignore ===
# Dependencias
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# Build y empaquetado Electron
dist/
out/
release/
build/mariadb-runtime/
*.exe
*.dmg
*.AppImage
*.deb
*.rpm
*.blockmap

# Variables de entorno y secretos (NUNCA COMMITEAR)
.env
.env.local
.env.*.local
config/app.env
!/.env.example

# Credenciales Firebase y service accounts
firebase-key.json
*firebase-adminsdk*.json
*-firebase-adminsdk-*.json
serviceAccountKey.json
service-account*.json
google-services.json
firebase-service-account.json
tecno-caja-admin/firebase-service-account.json
GoogleService-Info.plist

# Bases de datos locales
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
db/*.sqlite
db/tecnocaja.db
/data/
/backups/
*.novaseguro
secure-backups/

# Uploads de productos y archivos de usuario
uploads/
public/uploads/
productos-uploads/

# Sesión del bot de WhatsApp (whatsapp-web.js) — perfil de Chromium con
# caché/cookies/IndexedDB de la sesión ya vinculada, se regenera local en
# cada instalación, nunca debe versionarse.
.wwebjs_auth_pos/
.wwebjs_cache/

# Logs
logs/
*.log
tecnocaja-*.log
tecnocaja-electron-startup.log
tmp-*.out.log
tmp-*.log
server-*.out.log
server-*.log
desktop-*.out.log
desktop-*.log

# Semillas DGII locales
storage/ecf/seeds/
storage/ecf/ecf-originales-locales/

# IDE y editores
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Temporales del sistema operativo
*.tmp
*.temp
~$*
desktop.ini

# Caches
.cache/
.parcel-cache/
.next/
.nuxt/

# Playwright / Puppeteer
test-results/
playwright-report/
playwright/.cache/

# Cobertura y tests
coverage/
.nyc_output/

# Archivos de licencia locales
.tecnocaja-license
tecnocaja-license-*.json

# Archivos de respaldo generados
*.backup
*.bak
*.orig

# Storage ECF — solo trackear directorio base, no archivos generados
storage/ecf/certification/signed/
storage/ecf/certification/step4-rfce-status.json
storage/ecf/enviados/
storage/ecf/rfce-enviados/
storage/ecf/tracks/
storage/ecf/acecf-enviados/
storage/ecf/cert-wizard-state.json

# Backups de productos CSV (generados automáticamente)
storage/products/csv-backups/

# Scripts de operación one-shot (datos específicos de negocio)
/ecf/
scripts/250mil-upload/
scripts/portal-250mil-upload/

# Contadores app — archivos de build local
tecno-caja-contadores/node_modules/
tecno-caja-contadores/dist/

# Capacitor / Android — build local y config específica de máquina
capacitor/android/local.properties
capacitor/android/.gradle/
capacitor/android/build/
capacitor/android/app/build/
capacitor/android/**/*.iml
capacitor/android/.idea/
capacitor/android/captures/
capacitor/android/app/release/
*.keystore
*.jks

# Contadores mobile (Capacitor) — misma razón que capacitor/android arriba
contadores-mobile/android/.gradle/
contadores-mobile/android/local.properties
contadores-mobile/android/build/
contadores-mobile/android/app/build/

# Config de periféricos por terminal — se regenera localmente en cada
# instalación (impresora/gaveta/báscula de ESA caja física), no debe
# empaquetarse con un valor fijo para todos los clientes.
config/peripherals-config.json
config/terminal-config.json

# Claude Code — settings locales de esta máquina/sesión (allowlist de
# comandos, directorios adicionales), no es código del proyecto.
.claude/settings.json
.claude/settings.local.json

# Certificados fiscales DGII (.p12/.pfx) — NUNCA deben ir al repo, ni
# siquiera privado. Se purgó uno real del historial el 2026-08-01
# (modules/ecf/certificates/business-1-active.p12 estaba commiteado
# desde el commit inicial en un repo público de GitHub).
*.p12
*.pfx
modules/ecf/certificates/

# Material de referencia personal (plantilla oficial DGII + guía PDF),
# no es código del proyecto — no debe ir al repo.
llenado B06/

# Vistas previas temporales de facturas/reportes (salida de trabajo, no código)
_preview-*.html
_preview-*.pdf
